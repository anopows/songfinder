[Unit]
Description=songfinder health
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=songfinder
Group=songfinder
WorkingDirectory=/opt/songfinder
EnvironmentFile=/etc/songfinder.env
EnvironmentFile=/etc/songfinder-health.env
ExecStart=/opt/songfinder/deploy/healthcheck.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/songfinder
TimeoutStartSec=900
